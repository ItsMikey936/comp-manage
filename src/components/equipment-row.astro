---
// Sirve para los equipos que vienen de la base de datos (item) y como plantilla de equipo nuevo (sin item)
const { item = null, columns = [] } = Astro.props;

const states = [
  { value: 'Excelente', slug: 'excelente' },
  { value: 'Bueno', slug: 'bueno' },
  { value: 'Regular', slug: 'regular' },
  { value: 'Dañado', slug: 'danado' },
  { value: 'No disponible', slug: 'nodisponible' },
];

const slugOf = (value) => states.find((s) => s.value === value)?.slug ?? '';

// Resumen visible con el desplegable cerrado: prioriza lo que necesita atención
const values = columns.map((col) => item?.[col.key]);
const damaged = values.filter((v) => v === 'Dañado').length;
const regular = values.filter((v) => v === 'Regular').length;
const unset = values.filter((v) => !v).length;

let health = 'ok';
let healthText = 'Todo bien';
if (damaged) {
  health = 'bad';
  healthText = `${damaged} ${damaged === 1 ? 'dañado' : 'dañados'}`;
} else if (regular) {
  health = 'warn';
  healthText = `${regular} ${regular === 1 ? 'regular' : 'regulares'}`;
} else if (unset) {
  health = 'pending';
  healthText = `${unset} sin revisar`;
}

const badgeClasses = [
  'inline-flex shrink-0 items-center whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset',
  'bg-slate-100 text-slate-600 ring-slate-500/20',
  'data-[health=ok]:bg-emerald-50 data-[health=ok]:text-emerald-700 data-[health=ok]:ring-emerald-600/20',
  'data-[health=warn]:bg-amber-50 data-[health=warn]:text-amber-700 data-[health=warn]:ring-amber-600/20',
  'data-[health=bad]:bg-rose-50 data-[health=bad]:text-rose-700 data-[health=bad]:ring-rose-600/20',
].join(' ');

// El color del selector cambia según data-state (se actualiza solo al elegir otra opción)
const selectClasses = [
  'block w-full cursor-pointer rounded-md border-0 px-3 py-2.5 text-base font-medium ring-1 ring-inset sm:py-2 sm:text-sm',
  'bg-slate-100 text-slate-500 ring-slate-500/20',
  'data-[state=excelente]:bg-emerald-50 data-[state=excelente]:text-emerald-700 data-[state=excelente]:ring-emerald-600/20',
  'data-[state=bueno]:bg-sky-50 data-[state=bueno]:text-sky-700 data-[state=bueno]:ring-sky-600/20',
  'data-[state=regular]:bg-amber-50 data-[state=regular]:text-amber-700 data-[state=regular]:ring-amber-600/20',
  'data-[state=danado]:bg-rose-50 data-[state=danado]:text-rose-700 data-[state=danado]:ring-rose-600/20',
  'data-[state=nodisponible]:bg-slate-100 data-[state=nodisponible]:text-slate-600 data-[state=nodisponible]:ring-slate-500/20',
  'focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500',
  '[&>option]:bg-white [&>option]:text-slate-900',
].join(' ');
---

<details
  data-id={item?.id}
  class="group rounded-xl border border-slate-200 bg-white shadow-sm transition-shadow open:shadow-md"
>
  <summary
    class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-4 py-3 select-none hover:bg-slate-50 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 sm:px-5 [&::-webkit-details-marker]:hidden"
  >
    <span class="flex min-w-0 items-center gap-3">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-90"
        aria-hidden="true"
      >
        <path d="m9 6 6 6-6 6"></path>
      </svg>
      <span class="truncate text-base font-semibold text-slate-900">
        Equipo <span data-id-cell>{item?.id}</span>
      </span>
    </span>
    <span data-summary data-health={health} class={badgeClasses}>{healthText}</span>
  </summary>

  <div class="border-t border-slate-100 px-4 py-5 sm:px-5">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {columns.map((col) => (
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-slate-700">{col.label}</span>
          <select
            data-field={col.key}
            data-prev={item?.[col.key] ?? ''}
            data-state={slugOf(item?.[col.key])}
            class={selectClasses}
          >
            <option value="" disabled selected={!item?.[col.key]}>Elegir estado</option>
            {states.map((state) => (
              <option value={state.value} data-slug={state.slug} selected={item?.[col.key] === state.value}>
                {state.value}
              </option>
            ))}
          </select>
        </label>
      ))}

      <label class="block sm:col-span-2 lg:col-span-3 xl:col-span-4">
        <span class="mb-1.5 block text-sm font-medium text-slate-700">Nota</span>
        <textarea
          data-field="note"
          data-prev={item?.note ?? ''}
          rows="2"
          placeholder="Sin notas"
          class="block w-full resize-y rounded-md border border-slate-300 bg-white px-3 py-2.5 text-base text-slate-700 placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/30 sm:py-2 sm:text-sm"
        >{item?.note ?? ''}</textarea>
      </label>
    </div>
  </div>
</details>
