---
import "../styles/global.css"

// 1. Importa tu cliente de Supabase (ajusta la ruta según cómo lo hayas configurado)
import { supabase } from '../lib/supabase';
import EquipmentRow from './equipment-row.astro';

// 2. Consulta en el servidor. Orden ascendente: el equipo nuevo siempre queda al final, junto al botón +
const { data: equipmentList, error } = await supabase
  .from('computer_equipment')
  .select('*')
  .order('created_at', { ascending: true });

if (error) {
  console.error('Error al obtener los datos:', error);
}

const columns = [
  { key: 'monitor_status', label: 'Monitor' },
  { key: 'keyboard_status', label: 'Teclado' },
  { key: 'mouse_status', label: 'Mouse' },
  { key: 'ethernet_cable_status', label: 'Cable Ethernet' },
  { key: 'display_port_status', label: 'DisplayPort' },
  { key: 'charger_status', label: 'Cargador' },
  { key: 'lock_status', label: 'Candado' },
];

const total = equipmentList?.length ?? 0;
---

<section class="mx-auto w-full max-w-7xl px-4 py-8 font-sans sm:px-6 lg:px-8 lg:py-12">
  <header class="mb-6 flex flex-col gap-1 sm:mb-8 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">
      Inventario de equipos de cómputo
    </h2>
    {equipmentList && (
      <p id="equipment-count" class="text-sm text-slate-500">
        {total} {total === 1 ? 'equipo registrado' : 'equipos registrados'}
      </p>
    )}
  </header>

  {error && (
    <p
      role="alert"
      class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"
    >
      No se pudieron cargar los equipos. Recarga la página o inténtalo más tarde.
    </p>
  )}

  {equipmentList && (
    <>
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm xl:overflow-x-auto max-xl:border-0 max-xl:bg-transparent max-xl:shadow-none">
        <table class="w-full text-left text-sm max-xl:block">
          <thead class="bg-slate-50 text-xs font-semibold text-slate-600 max-xl:hidden">
            <tr class="border-b border-slate-200">
              <th scope="col" class="px-3 py-3 xl:px-4">Equipo</th>
              {columns.map((col) => (
                <th scope="col" class="px-3 py-3 xl:px-4">{col.label}</th>
              ))}
              <th scope="col" class="px-3 py-3 xl:px-4">Nota</th>
            </tr>
          </thead>

          <tbody
            id="equipment-body"
            class="divide-y divide-slate-100 max-xl:grid max-xl:grid-cols-1 max-xl:gap-3 max-xl:divide-y-0 md:max-xl:grid-cols-2"
          >
            {total === 0 && (
              <tr id="empty-row" class="max-xl:block md:max-xl:col-span-2">
                <td
                  colspan={columns.length + 2}
                  class="px-4 py-10 text-center text-sm text-slate-500 max-xl:block max-xl:rounded-xl max-xl:border max-xl:border-dashed max-xl:border-slate-300"
                >
                  Todavía no hay equipos. Usa el botón + para agregar el primero.
                </td>
              </tr>
            )}
            {equipmentList.map((item) => (
              <EquipmentRow item={item} columns={columns} />
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-6 flex flex-col items-center gap-2">
        <button
          id="add-equipment"
          type="button"
          aria-label="Agregar equipo"
          title="Agregar equipo"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-sky-600 text-white shadow-sm transition hover:bg-sky-700 focus:outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500 disabled:cursor-not-allowed disabled:opacity-60"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14"></path>
          </svg>
        </button>
        <p id="equipment-message" role="status" aria-live="polite" class="min-h-5 text-center text-sm"></p>
      </div>

      <!-- Plantilla de la fila que se agrega al pulsar + -->
      <template id="row-template">
        <EquipmentRow columns={columns} />
      </template>
    </>
  )}
</section>

<script>
  const tbody = document.getElementById('equipment-body') as HTMLTableSectionElement | null;
  const addButton = document.getElementById('add-equipment') as HTMLButtonElement | null;
  const template = document.getElementById('row-template') as HTMLTemplateElement | null;
  const message = document.getElementById('equipment-message') as HTMLParagraphElement | null;
  const count = document.getElementById('equipment-count');

  let messageTimer: number | undefined;

  const showMessage = (text: string, type: 'ok' | 'error') => {
    if (!message) return;
    message.textContent = text;
    message.className =
      type === 'ok'
        ? 'min-h-5 text-center text-sm font-medium text-emerald-700'
        : 'min-h-5 text-center text-sm font-medium text-rose-700';
    window.clearTimeout(messageTimer);
    messageTimer = window.setTimeout(() => {
      message.textContent = '';
    }, type === 'ok' ? 3000 : 8000);
  };

  // Llama al servidor; si algo falla lanza un Error con el motivo para mostrarlo en pantalla
  const request = async (method: 'POST' | 'PATCH', body?: unknown) => {
    const response = await fetch('/api/equipment', {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) {
      if (response.status === 404) {
        throw new Error('No se encontró /api/equipment. Revisa que exista src/pages/api/equipment.ts');
      }
      throw new Error(result.error ?? `Error del servidor (${response.status})`);
    }
    return result;
  };

  const updateCount = () => {
    if (!tbody || !count) return;
    const total = tbody.querySelectorAll('tr[data-id]').length;
    count.textContent = `${total} ${total === 1 ? 'equipo registrado' : 'equipos registrados'}`;
  };

  // Actualiza el color del selector según la opción elegida
  const paintSelect = (select: HTMLSelectElement) => {
    select.dataset.state = select.selectedOptions[0]?.dataset.slug ?? '';
  };

  // Guardado automático: al cambiar un estado o una nota se actualiza esa fila
  tbody?.addEventListener('change', async (event) => {
    const target = event.target as HTMLSelectElement | HTMLInputElement;
    const field = target.dataset.field;
    const id = target.closest('tr')?.dataset.id;
    if (!field || !id) return;

    if (target instanceof HTMLSelectElement) paintSelect(target);

    try {
      await request('PATCH', { id: Number(id), field, value: target.value.trim() || null });
      target.dataset.prev = target.value;
      showMessage('Cambio guardado.', 'ok');
    } catch (err) {
      console.error('Error al guardar el cambio:', err);
      target.value = target.dataset.prev ?? '';
      if (target instanceof HTMLSelectElement) paintSelect(target);
      showMessage(err instanceof Error ? err.message : 'No se pudo guardar el cambio.', 'error');
    }
  });

  // Botón +: crea el equipo (el id se incrementa solo) y agrega la fila
  addButton?.addEventListener('click', async () => {
    if (!tbody || !template) return;
    addButton.disabled = true;

    try {
      const { id } = await request('POST');

      const fragment = template.content.cloneNode(true) as DocumentFragment;
      const row = fragment.querySelector('tr') as HTMLTableRowElement;
      row.dataset.id = String(id);
      const idCell = row.querySelector('[data-id-cell]');
      if (idCell) idCell.textContent = String(id);

      document.getElementById('empty-row')?.remove();
      tbody.appendChild(row);
      updateCount();

      row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      (row.querySelector('select') as HTMLSelectElement | null)?.focus();
      showMessage(`Equipo ${id} agregado.`, 'ok');
    } catch (err) {
      console.error('Error al agregar el equipo:', err);
      showMessage(err instanceof Error ? err.message : 'No se pudo agregar el equipo.', 'error');
    } finally {
      addButton.disabled = false;
    }
  });
</script>
